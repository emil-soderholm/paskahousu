# Apache configuration for public_html hosting
AddDefaultCharset UTF-8
AddType text/html;charset=utf-8 .html
AddType text/css;charset=utf-8 .css
AddType application/javascript;charset=utf-8 .js

# If running python3 server.py on the school machine (e.g. port 8000),
# you can proxy WebSocket and API requests by uncommenting:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP:Upgrade} websocket [NC]
#   RewriteCond %{HTTP:Connection} upgrade [NC]
#   RewriteRule ^ws(.*)$ ws://localhost:8000/ws$1 [P,L]
#   RewriteRule ^api/(.*)$ http://localhost:8000/api/$1 [P,L]
# </IfModule>

